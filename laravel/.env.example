# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Kitu Analytics"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=kitu_analytics
DB_USERNAME=kitu_user
DB_PASSWORD=

# ── Cache & Sessions ──────────────────────────────────────────────────────────
CACHE_STORE=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── ML Service ────────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://ml:8001

# ── Africa's Talking (SMS + USSD) ─────────────────────────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=KITU
AT_ENV=sandbox
# AT_ENV=production  ← switch when going live

# ── Queue ─────────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=redis

# ── Mail (optional) ───────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@kitu.co.tz
MAIL_FROM_NAME="Kitu Analytics"